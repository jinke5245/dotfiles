{
  "name": "@jinke5245/dotfiles",
  "engines": {
    "node": ">=22.22.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "bats": "^1.13.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-json-schema-validator": "^6.3.1",
    "eslint-plugin-yml": "^3.8.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "prettier-plugin-sh": "^0.19.0"
  },
  "scripts": {
    "prepare": "husky",
    "check": "run-s lint format:check test",
    "lint-staged": "lint-staged --concurrent false",
    "lint": "run-s --continue-on-error lint:*",
    "lint:eslint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "run-s test:unit test:integration",
    "test:unit": "echo \"No unit tests\"",
    "test:integration": "bats --recursive --print-output-on-failure tests/integration"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
