{
  "name": "@jinke5245/dotfiles",
  "engines": {
    "node": ">=22.22.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "bats": "^1.13.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-json-schema-validator": "^6.3.2",
    "eslint-plugin-yml": "^3.10.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.10.1",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "prettier-plugin-sh": "^0.19.0"
  },
  "scripts": {
    "prepare": "node scripts/dev/prepare-husky.mjs",
    "prepare:husky": "node scripts/dev/prepare-husky.mjs",
    "check": "run-s lint format:check test",
    "lint-staged": "lint-staged --concurrent false",
    "lint": "run-s --continue-on-error lint:*",
    "lint:eslint": "eslint .",
    "format": "run-s format:fix",
    "format:fix": "run-s format:fix:*",
    "format:fix:prettier": "prettier --write .",
    "format:check": "run-s format:check:*",
    "format:check:prettier": "prettier --check .",
    "test": "run-s test:unit test:integration",
    "test:unit": "echo \"No unit tests\"",
    "test:integration": "bats --recursive --print-output-on-failure tests/integration",
    "test:e2e": "bats --recursive --filter-tags '!network' --print-output-on-failure tests/e2e",
    "test:setup": "bats --recursive --filter-tags network,container --print-output-on-failure tests/e2e",
    "test:setup:macos": "bats --recursive --filter-tags network,macos --print-output-on-failure tests/e2e",
    "ci:run": "bash scripts/dev/run-if-available.sh act workflow_dispatch",
    "ci:test": "run-s ci:test:*",
    "ci:test:check": "pnpm ci:run --job check",
    "ci:test:test-e2e": "pnpm ci:run --job test-e2e --matrix os:ubuntu-latest",
    "ci:test:test-setup": "pnpm ci:run --job test-setup --matrix os:ubuntu-latest"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
