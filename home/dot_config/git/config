[user]
	useConfigOnly = true

[init]
	defaultBranch = main

[fetch]
	prune = true

[pull]
	ff = only

[core]
	quotePath = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# Keep device-specific settings last so they can override shared defaults.
[include]
	path = config.local
