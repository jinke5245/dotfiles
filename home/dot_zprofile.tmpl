{{- $brew := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- if eq .chezmoi.arch "arm64" -}}
{{- $brew = "/opt/homebrew/bin/brew" -}}
{{- else -}}
{{- $brew = "/usr/local/bin/brew" -}}
{{- end -}}
{{- else if eq .chezmoi.os "linux" -}}
{{- $brew = "/home/linuxbrew/.linuxbrew/bin/brew" -}}
{{- end -}}
# Initialize the selected homebrew installation for login shells.
if (( $+commands[brew] )); then
  eval "$(brew shellenv zsh)"
{{- if $brew }}
elif [[ -x {{ $brew | quote }} ]]; then
  eval "$({{ $brew | quote }} shellenv zsh)"
{{- end }}
fi

# Keep user executables first without accumulating duplicate paths.
typeset -U path PATH
path=("$HOME/bin" "$HOME/.local/bin" "$HOME/go/bin" /usr/local/bin $path)
export PATH

{{ if eq .chezmoi.os "linux" }}
# Reuse or start ssh-agent when no agent is inherited.
if [ -z "${SSH_AUTH_SOCK:-}" ]; then
  if [ -f "$HOME/.ssh/ssh-agent" ]; then
    eval "$(cat "$HOME/.ssh/ssh-agent")" > /dev/null
  fi
  SSH_AGENT_STATUS=0
  ssh-add -l > /dev/null 2>&1 || SSH_AGENT_STATUS=$?
  # Exit 1 means a live agent without keys; only 2 means it cannot be reached.
  if [ "$SSH_AGENT_STATUS" = "2" ]; then
    ssh-agent -s &> "$HOME/.ssh/ssh-agent"
    eval "$(cat "$HOME/.ssh/ssh-agent")" > /dev/null
  fi

  if [ -f "$HOME/.ssh/id_ed25519" ]; then
    ssh-add "$HOME/.ssh/id_ed25519" 2> /dev/null
  fi
fi
{{ end }}

# Load machine-local login overrides after shared configuration.
if [[ -r "$HOME/.zprofile.local" ]]; then
  source "$HOME/.zprofile.local"
fi
